{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@components": ["./components/index.tsx"],
      "@contexts": ["./contexts/index.tsx"],
      "@contexts/*": ["./contexts/*"],
      "@const": ["./const/index.ts"],
      "@hooks/*": ["./hooks/*"],
      "@hooks/use-document-title": ["./hooks/use-document-title.ts"],
      "@assets": ["./assets"],
      "@assets/*": ["./assets/*"],
      "@lib/*": ["./lib/*"],
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
