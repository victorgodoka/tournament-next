NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DISCORD_URL=
# Builds profile cover URLs. The segment after /v1_1/ in the cover-upload `uploadUrl`.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# "cloudinary": card art through Cloudinary fetch (needs "Fetched URL" allowed for ygopro.online). Unset: Next's optimizer.
NEXT_PUBLIC_CARD_ART_FETCH=

# Server-only (required for response_type=code)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
